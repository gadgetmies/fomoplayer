{
  "name": "fomoplayer",
  "version": "1.0.0",
  "description": "",
  "main": "ecosystem.config.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "migrate": "yarn workspace fomoplayer_back migrate",
    "db-migrate:prod": "yarn workspace fomoplayer_back db-migrate:prod",
    "db-migrate:prod:retry": "yarn workspace fomoplayer_back db-migrate:prod:retry",
    "db:wait": "yarn workspace fomoplayer_back db:wait",
    "start:back": "yarn workspace fomoplayer_back start",
    "start:back:prod": "yarn workspace fomoplayer_back start:prod",
    "start:front": "yarn workspace fomoplayer_front start",
    "start:prod-front": "yarn workspace fomoplayer_front start:prod",
    "start": "concurrently \"yarn run start:back\" \"yarn run start:front\"",
    "start:integration-tests": "concurrently \"NODE_ENV=test yarn run start:back\" \"NODE_ENV=test yarn run start:front\"",
    "start:prod": "yarn run start:back:prod",
    "ci:test": "yarn workspace fomoplayer_back ci:test",
    "test:browser": "NODE_ENV=test yarn build && yarn workspace fomoplayer_back test:browser",
    "test:browser:demo": "NODE_ENV=test yarn build && yarn workspace fomoplayer_back test:browser:demo",
    "test:browser:all": "NODE_ENV=test yarn build && yarn workspace fomoplayer_back test:browser:all",
    "ci:test:browser": "NODE_ENV=ci yarn build && yarn workspace fomoplayer_back ci:test:browser",
    "ci:test:browser:demo": "NODE_ENV=ci yarn build && yarn workspace fomoplayer_back ci:test:browser:demo",
    "ci:test:browser:all": "NODE_ENV=ci yarn build && yarn workspace fomoplayer_back ci:test:browser:all",
    "test": "yarn workspace fomoplayer_back test",
    "ui:test": "yarn workspace fomoplayer_integration_tests test",
    "ciui:test": "yarn workspace fomoplayer_integration_tests ci:test",
    "build": "yarn workspace fomoplayer_front build",
    "db:backup": "heroku pg:backups:capture",
    "backlog:sync": "node scripts/backlog-sync sync",
    "backlog:sync:init": "node scripts/backlog-sync init",
    "backlog:sync:status": "node scripts/backlog-sync status",
    "postinstall": "patch-package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gadgetmies/fomoplayer.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gadgetmies/fomoplayer/issues"
  },
  "homepage": "https://github.com/gadgetmies/fomoplayer#readme",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pm2": "^7.0.4",
    "prettier": "^3.3.3"
  },
  "private": true,
  "workspaces": [
    "packages/**"
  ],
  "resolutions": {
    "shell-quote": "^1.11.0",
    "serialize-javascript": "^7.1.2",
    "underscore": "^1.13.8",
    "**/editorconfig/minimatch": "^9.0.9",
    "**/pm2/js-yaml": "^4.3.2",
    "**/get-uri/basic-ftp": "^6.2.1",
    "uuid": "^14.0.2",
    "@svgr/webpack": "^8.1.0",
    "resolve-url-loader": "^5.0.0",
    "**/react-scripts/webpack-dev-server": "^5.2.6",
    "**/http-proxy-agent/@tootallnate/once": "^2.0.1",
    "**/minio/stream-json": "^3.7.0",
    "decode-uri-component": "^0.5.0"
  }
}
