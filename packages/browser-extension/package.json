{
  "name": "fomoplayer_browser_extension",
  "version": "0.1.0",
  "description": "Fomo Player browser extension",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "yarn build:chrome && yarn build:firefox && yarn build:safari",
    "build:chrome": "NODE_ENV=production BROWSER=chrome node utils/build.js",
    "build:firefox": "NODE_ENV=production BROWSER=firefox node utils/build.js",
    "build:safari": "NODE_ENV=production BROWSER=safari node utils/build.js",
    "build:safari:app": "yarn build:safari && yarn xcodebuild:safari",
    "xcodebuild:safari": "xcodebuild -project \"Fomo Player/Fomo Player.xcodeproj\" -scheme \"Fomo Player (macOS)\" -configuration Release -derivedDataPath build/xcode CODE_SIGN_IDENTITY=\"-\" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO",
    "regenerate:safari-xcodeproj": "yarn build:safari && xcrun safari-web-extension-converter build/safari --project-location . --app-name \"Fomo Player\" --bundle-identifier com.gadgetmies.Fomo-Player --swift --no-open --no-prompt --force",
    "clean:safari:app": "rm -rf build/xcode && rm -rf \"Fomo Player\"",
    "start": "BROWSER=${BROWSER:-chrome} node utils/webserver.js",
    "watch": "node utils/watch.js",
    "watch:chrome": "BROWSERS=chrome node utils/watch.js",
    "watch:firefox": "BROWSERS=firefox node utils/watch.js",
    "watch:all": "BROWSERS=chrome,firefox node utils/watch.js",
    "lint:firefox": "web-ext lint --source-dir=build/firefox",
    "test": "cascade-test ./test/tests"
  },
  "dependencies": {
    "@hot-loader/react-dom": "^17.0.1",
    "@sentry/browser": "^11.4.0",
    "dotenv": "^18.0.5",
    "fomoplayer_shared": "1.0.0",
    "new-github-issue-url": "^1.0.0",
    "partial.lenses": "^14.17.0",
    "ramda": "^0.27.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typeface-lato": "^1.1.13",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "cascade-test": "^0.4.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "fs-extra": "^11.4.1",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "react-hot-loader": "^4.13.0",
    "style-loader": "^4.0.0",
    "web-ext": "^10.7.0",
    "webpack": "^5.76.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "write-file-webpack-plugin": "^4.5.1"
  }
}
